{
  "name": "@meshscale/sdk",
  "version": "0.1.7",
  "description": "Official TypeScript SDK for MeshScale",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup index.ts --format esm --clean --out-dir dist --target es2022 && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate-and-build": "pnpm generate && pnpm build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}